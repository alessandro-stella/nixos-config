{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "padding": {
      "top": 1,
      "left": 3
    }
  },
  "display": {
    "separator": " ",
    "percent": {
      "color": {
        "green": "",
        "yellow": "",
        "red": ""
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m╭───────────────────── Hardware ──────────────────────"
    },
    {
      "type": "host",
      "key": " PC"
    },
    {
      "type": "cpu",
      "key": "│ ├󰍛"
    },
    {
      "type": "gpu",
      "key": "│ ├󰍛"
    },
    {
      "type": "memory",
      "key": "│ ├󰍛"
    },
    {
      "type": "disk",
      "key": "└ └󰋊"
    },
    {
      "type": "custom",
      "format": "\u001b[90m╰─────────────────────────────────────────────────────"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m╭───────────────────── Software ──────────────────────"
    },
    {
      "type": "os",
      "key": " OS"
    },
    {
      "type": "kernel",
      "key": "│ ├"
    },
    {
      "type": "command",
      "key": "│ ├",
      "text": "hyprctl version | awk 'NR==1 {print \"Hyprland\", $2, \"(Wayland)\"}'"
    },
    {
      "type": "command",
      "key": "│ ├󰏖",
      "text": "cat ~/.local/share/nix-installed-packages"
    },
    {
      "type": "shell",
      "key": "│ ├"
    },
    {
      "type": "terminal",
      "key": "└ └"
    },
    {
      "type": "custom",
      "format": "\u001b[90m╰─────────────────────────────────────────────────────"
    },
    "break",
    {
      "type": "colors",
      "symbol": "block"
    }
  ]
}
